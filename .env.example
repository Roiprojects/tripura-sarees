# Copy this file to `.env` after cloning from GitHub.
# These values come from your Lovable Cloud / Supabase project settings.
# Without them, the deployed site cannot load products, banners, or images.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Optional: build the site for a subfolder URL (e.g. example.com/shop/)
# Must start and end with a "/". Defaults to "/" (domain root).
# VITE_BASE_PATH=/shop/

# Optional: origin used to serve bundled design assets (banners, logos, etc.)
# that were uploaded to the Lovable asset CDN during development. Defaults to
# the published Lovable URL so they load from any deployment. Override if you
# re-host these assets on your own CDN / S3 / Cloudinary bucket.
# VITE_ASSET_ORIGIN=https://cdn.your-domain.com
