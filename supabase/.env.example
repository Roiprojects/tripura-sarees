# Server-side secrets for Supabase Edge Functions
# Set these in your native Supabase project, not in the browser build.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_KEY

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

ERP_API_KEY=YOUR_SHARED_ERP_API_KEY

NETTYFISH_USER=YOUR_NETTYFISH_USER
NETTYFISH_PASSWORD=YOUR_NETTYFISH_PASSWORD
NETTYFISH_SENDER_ID=YOUR_DLT_SENDER_ID
NETTYFISH_ROUTE=17

# Used by analyze-product-image and generate-product-description
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# Store name used in SMS texts and AI product copy prompts
STORE_NAME=Tripura Sarees
# Domain for synthetic phone-login emails; must match site.auth.phoneEmailDomain in src/config/site.ts
PHONE_AUTH_EMAIL_DOMAIN=phone.tripurasarees.app
